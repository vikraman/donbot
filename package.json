{
  "name": "donbot",
  "version": "1.0.0",
  "description": "A simple helpful robot for your Company",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "source .env && hubot --name donbot --adapter @hubot-friends/hubot-discord",
    "start:shell": "source .env 2>/dev/null; export REDIS_URL=redis://localhost:6379; hubot --name donbot --adapter Shell",
    "redis:local": "docker compose up -d redis",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test tests/*.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@hubot-friends/hubot-discord": "^4.2.0",
    "emojilib": "^4.0.3",
    "hubot": "^14.1.0",
    "hubot-diagnostics": "^2.1.3",
    "hubot-help": "^2.1.5",
    "hubot-redis-brain": "^3.0.1",
    "hubot-rules": "^2.1.1",
    "most-common-words-by-language": "^3.0.14",
    "sentiment": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
